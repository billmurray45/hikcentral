# Application
APP_NAME=HR Attendance API
APP_VERSION=1.0.0
DEBUG=False

# Database
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=hr_attendance
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# HikCentral API
HIKVISION_BASE_URL=https://hikvision.university.kz
HIKVISION_USERNAME=api_user
HIKVISION_PASSWORD=api_password
HIKVISION_TIMEOUT=30
HIKVISION_MAX_RETRIES=3
HIKVISION_PAGE_SIZE=500
HIKVISION_VERIFY_SSL=True

# Sync Settings
SYNC_INTERVAL_MINUTES=15
SYNC_BATCH_SIZE=500
SYNC_PARALLEL_REQUESTS=3
SYNC_FULL_SYNC_HOUR=2
SYNC_PERSON_SYNC_HOUR=3
SYNC_RETENTION_DAYS=365

# Cache TTL (seconds)
CACHE_DAILY_TTL=300
CACHE_EMPLOYEE_TTL=900
CACHE_SUMMARY_TTL=600
CACHE_PERSONS_TTL=86400

# CORS (comma-separated for multiple origins)
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
